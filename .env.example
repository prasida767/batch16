# =============================================================================
# Batch 16 — environment template (safe to commit)
# Copy to `.env.local` and fill in real values. Never commit `.env.local`.
# =============================================================================

# Supabase project (Dashboard → Settings → API)
# Use the project URL only — do NOT append /rest/v1/
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# NEVER put the Supabase service_role key in this app.
# The server uses DATABASE_URL (Postgres) via Drizzle instead.

# Production site URL (auth email redirects + API origin checks)
# NEXT_PUBLIC_SITE_URL="https://your-app.example.com"

# Postgres for Drizzle (server-only — do NOT prefix NEXT_PUBLIC_)
# On Vercel use the Transaction pooler (port 6543), NOT Session (5432).
# Supabase → Settings → Database → Connection string → Transaction pooler
# Example host ends with: aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres.PROJECT:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"
# Optional. Default: 1 on Vercel, 8 for next dev / next start.
# DB_POOL_MAX="8"

# Official FPL classic league ID (fantasy.premierleague.com/leagues/XXXX/standings)
FPL_LEAGUE_ID="123456"

# Comma-separated emails allowed into /admin
ADMIN_EMAILS="you@example.com"

# Dressing Room uses Supabase Realtime (presence + broadcast).
# Enable Realtime for your project; no extra env vars required beyond the anon key above.
