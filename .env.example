# =============================================================================
# Batch 16 — environment template (safe to commit)
# Copy to `.env.local` and fill in real values. Never commit `.env.local`.
# =============================================================================

# Supabase project (Dashboard → Settings → API)
# Use the project URL only — do NOT append /rest/v1/
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# Keep NEXT_PUBLIC_SUPABASE_* for login (Auth). DATABASE_URL can be Railway.

# Production site URL (auth email redirects + API origin checks)
# NEXT_PUBLIC_SITE_URL="https://your-app.example.com"

# Postgres for Drizzle (server-only — do NOT prefix NEXT_PUBLIC_)
# Prefer a small always-on host (Railway ~$5) over Supabase free.
# After creating Railway Postgres:
#   1. Put the NEW url in DATABASE_URL
#   2. Put the OLD Supabase url in SOURCE_DATABASE_URL
#   3. npm run db:push && npm run db:copy-from-source
#   4. Set the same PUBLIC URL on Vercel (host should look like xxx.proxy.rlwy.net).
#      Do NOT use *.railway.internal — that only works inside Railway.
#      Do NOT leave the old Supabase Postgres URL on Vercel.
DATABASE_URL="postgresql://postgres:PASSWORD@HOST:5432/railway"
# SOURCE_DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"

# Official FPL classic league ID (fantasy.premierleague.com/leagues/XXXX/standings)
FPL_LEAGUE_ID="123456"

# If League/Live return FPL 403 on Vercel, proxy through a Cloudflare Worker:
# deploy scripts/fpl-proxy-worker.js and paste the workers.dev URL here (no trailing slash).
# FPL_PROXY_BASE_URL="https://YOUR-WORKER.workers.dev"

# Comma-separated emails allowed into /admin
ADMIN_EMAILS="you@example.com"

# Dressing Room polls while open (no Realtime required).
